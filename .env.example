# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=True
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1

# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us
GCP_PROCESSOR_ID=your-document-ai-processor-id
GCP_VERTEX_AI_LOCATION=us-central1
GCP_MODEL_NAME=gemini-1.0-pro-vision-001

# Google Cloud Credentials
# Path to your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=application_default_credentials.json

# Database Configuration (Optional - currently using SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Security Settings (Production)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Logging
# DJANGO_LOG_LEVEL=INFO
